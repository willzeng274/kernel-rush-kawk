+def triple_slot(key: int, oldest: int) -> int:
+    """Hash a 96-bit context; the complete tail-pair and oldest tags are checked."""
+    combined = key ^ (((oldest + 1) * 11400714819323198485) & ((1 << 64) - 1))
+    return pair_slot(combined)
